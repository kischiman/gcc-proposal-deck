{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-private-pages.mjs && node build-budget-embed.mjs && node build-artifact.js",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/budget",
      "destination": "/budget.html"
    },
    {
      "source": "/m",
      "destination": "/mobile.html"
    },
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    }
  ]
}
